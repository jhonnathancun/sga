// Diagrama 4. Modelo de datos conceptual (Graphviz, generado por er.py)
digraph ER {
graph [rankdir=TB, fontname="Arial", nodesep=0.35, ranksep=0.55, pad=0.25, bgcolor=white, splines=true];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, arrowhead=none, color="#555555", labelfontsize=10, labelfontcolor="#b71c1c"];
